# Customer Facing Assistant PoC - environment.
#
#   make init    creates .env from this file with fresh random local secrets.
#
# .env is gitignored. Never commit real values. Every credential in the stack is
# read from here; nothing secret lives in code, compose files or gateway profiles.

# ---------------------------------------------------------------------------
# Model endpoints (fill these in, then: make gateway PROFILE=live)
# ---------------------------------------------------------------------------
# The agent never sees these: only the LiteLLM gateway does. The agent calls the
# aliases "assistant-fast" and "assistant-reasoning".
#
# MODEL_*_LITELLM_MODEL uses LiteLLM's "<provider>/<model-or-deployment>" format:
#   Azure OpenAI / Foundry (Azure OpenAI endpoint):
#     MODEL_FAST_LITELLM_MODEL=azure/<your-gpt-5-mini-deployment-name>
#     MODEL_FAST_API_BASE=https://<resource>.openai.azure.com
#     MODEL_FAST_API_VERSION=2025-04-01-preview
#   OpenAI-compatible endpoint (OpenAI, Foundry /openai/v1, APIM front door...):
#     MODEL_FAST_LITELLM_MODEL=openai/gpt-5-mini
#     MODEL_FAST_API_BASE=https://<host>/openai/v1
#     MODEL_FAST_API_VERSION=            (leave empty)

# Alias "assistant-fast" (intent classification + orders/billing/service answers): a small fast model
# (gpt-4.1-mini in the reference setup; gpt-5-mini works the same way)
MODEL_FAST_LITELLM_MODEL=
MODEL_FAST_API_BASE=
MODEL_FAST_API_KEY=
MODEL_FAST_API_VERSION=2025-04-01-preview

# Alias "assistant-reasoning" (troubleshooting): gpt-5.4
MODEL_REASONING_LITELLM_MODEL=
MODEL_REASONING_API_BASE=
MODEL_REASONING_API_KEY=
MODEL_REASONING_API_VERSION=2025-04-01-preview

# Optional: a model from a DIFFERENT vendor for `make gateway PROFILE=live-alt` /
# `make compare-providers B=live-alt`. It takes over assistant-reasoning; assistant-fast is unchanged.
# Example (a Foundry catalogue model deployed on the same AI Services resource):
#   MODEL_ALT_LITELLM_MODEL=azure_ai/DeepSeek-V3.2
#   MODEL_ALT_API_BASE=https://<resource>.services.ai.azure.com/models
MODEL_ALT_LITELLM_MODEL=
MODEL_ALT_API_BASE=
MODEL_ALT_API_KEY=
MODEL_ALT_API_VERSION=

# ---------------------------------------------------------------------------
# Local secrets (generated by make init; rotate by deleting .env and re-running)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
DB_PASSWORD_ORDERS=
DB_PASSWORD_BILLING=
DB_PASSWORD_SERVICE=
DB_PASSWORD_PLATFORM=
DB_PASSWORD_EVAL=
# Client secret the agent uses to authenticate to the IdP for token exchange.
AGENT_CLIENT_SECRET=
# Key the agent uses to call the gateway (and the gateway's admin key).
LITELLM_MASTER_KEY=
# Key for the offline scripted model provider.
FAKE_LLM_API_KEY=

# ---------------------------------------------------------------------------
# Local-only switches
# ---------------------------------------------------------------------------
# Lets eval mutant M2 disable the tenant check on skill servers. Never true outside local eval.
ALLOW_EVAL_MUTANTS=true
# Shows the UI model selector (re-point gateway aliases from the header). Local demo
# only: any signed-in persona can change models. Defaults to true in docker-compose.yml.
GATEWAY_ADMIN_ENABLED=true
